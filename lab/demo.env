# Which repository the demo exports from, and where its history comes from.
# Source this next to lab/.secrets before running any station:
#
#   source lab/.secrets
#   source lab/demo.env
#
# This is NOT the Hub2Lab repository. It is the throwaway stand-in for the
# developers' GitHub repository outside the wall: the code the airlock carries,
# not the machinery that carries it. It holds a copy of the migration project
# below, plus whatever the demo stages push into it.
#
# Keep it PRIVATE. It is seeded from a real project and the stages commit things
# nobody wants indexed.
export AIRLOCK_SOURCE_URL='https://github.com/krixerx/airlock-demo-source'

# The real project the demo repository is seeded from, once, by
# scripts/demo-seed.sh baseline. Read only; nothing is ever pushed back to it.
export AIRLOCK_DEMO_SOURCE='https://github.com/krixerx/adabas-to-oracle-migration'

# The commit GitLab last accepted, which is the base for the next export and the
# base the stage 3 rewrite must preserve. Written by airlock-confirm.sh.
accepted() {
  python -c "import json,sys;print(json.load(open(sys.argv[1]))['accepted_sha'])" \
    "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/transfer/state/last-accepted.json"
}
