# Copy to lab/.env and edit. lab/.env is local to this PC and is not shared.

# Initial password for the GitLab root account. First boot only.
#
# Generate both of these, do not invent them by hand. GitLab's first-boot seed
# refuses a password it reads as a common word combination, and it fails quietly:
# reconfigure reports success and the instance simply has no users at all.
#   openssl rand -base64 18
GITLAB_ROOT_PASSWORD=

# Password for the two lab accounts, importer and secreviewer. Set before the
# first bootstrap; the accounts keep it once they exist.
AIRLOCK_USER_PASSWORD=

# Filled in by scripts/gitlab-bootstrap.sh after the project exists.
# Read-only deploy token URL the station uses to mirror GitLab.
QUARANTINE_REMOTE=
